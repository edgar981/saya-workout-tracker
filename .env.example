# Respaldo automático a Postgres (DECISIONES.md §9).
# Copia este archivo a .env (local) y ponlo también en las Environment Variables
# de Vercel. .env real está en .gitignore; este ejemplo sí se versiona.

# Cadena de conexión de Neon Postgres. Usa el host con -pooler (conexión
# agrupada), que es lo que quieren las funciones serverless de Vercel.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Token del endpoint de respaldo. El servidor compara contra este (tiempo
# constante). No es seguridad fuerte: protege de escrituras casuales de
# terceros, no de alguien que inspeccione el bundle. Es proporcional — son
# datos de gimnasio de una persona. Pon el MISMO valor en las dos variables.
BACKUP_TOKEN="pon-aqui-un-secreto-largo-y-aleatorio"

# El cliente lo lleva embebido en el bundle (NEXT_PUBLIC_*), a la vista de quien
# mire el JavaScript. Mismo valor que BACKUP_TOKEN.
NEXT_PUBLIC_BACKUP_TOKEN="pon-aqui-un-secreto-largo-y-aleatorio"

# Login (DECISIONES.md §14). Las tres son del servidor: ninguna va con
# NEXT_PUBLIC_.

# Secreto con el que Better Auth firma y cifra las sesiones. Al menos 32
# caracteres al azar, y uno distinto por entorno (producción y preview).
BETTER_AUTH_SECRET="reemplazame-con-un-secreto-real"

# La dirección exacta del entorno: la de producción, o la de la rama en el
# preview. Es la única dirección de confianza del login y de ella salen el
# rpID y el origin del passkey.
BETTER_AUTH_URL="https://tu-entorno.example.com"

# El único correo que puede tener cuenta. Sin esta variable no se puede crear
# ninguna.
AUTH_ALLOWED_EMAIL="tu-correo@example.com"
