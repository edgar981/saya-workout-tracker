// Respaldo automático a Postgres (DECISIONES.md §9). Primera vez que este
// proyecto tiene backend. NO es sync: es un push de snapshots completos,
// append-only. Dexie es la fuente de verdad del entrenamiento y Cuerpo, y
// Snapshot es su respaldo: sólo el flujo explícito de restauración lo lee.
// Dinero y Tiempo viven aquí, en sus siete tablas, como su única fuente
// (DECISIONES.md §15).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Un volcado completo de las ocho tablas de Dexie, tal cual lo produce el
/// export de /datos. Append-only: cada push es una fila nueva, nunca se
/// sobrescribe ni se borra. Si un push manda una base vacía por accidente, los
/// snapshots anteriores siguen aquí — que es justo el escenario que se cubre.
model Snapshot {
  id             String   @id @default(uuid()) @db.Uuid
  creado_en      DateTime @default(now()) @db.Timestamptz(6)
  /// schema_version del manifiesto. El servidor no lo valida contra un valor
  /// propio: guarda lo que venga. El match de versión se exige en la RESTAURACIÓN
  /// (lado cliente), no en el push.
  schema_version Int
  /// manifest.counts del export: filas por tabla. Se expone en los listados sin
  /// tener que traer el payload entero.
  counts         Json
  /// El volcado completo { manifest, data }. Lo único que el flujo de restore
  /// descarga y mete por el import existente.
  payload        Json

  @@index([creado_en])
}

// Cuentas (DECISIONES.md §14). Los nombres de modelo y de campo son los que el
// adaptador de Prisma de Better Auth 1.7.18 espera con esta configuración
// (núcleo + passkey + límite de intentos en base): los fija el paquete, no
// esta app. Los ids son texto que genera Better Auth.

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  passkeys      Passkey[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

// Dinero y Tiempo (DECISIONES.md §15): su única copia vive aquí, no en Dexie.
// Los ids los genera el teléfono (crypto.randomUUID) para que reintentar un
// guardado no duplique. Pesos colombianos enteros (BigInt). Los `tipo` son texto
// que valida el servidor, no enum. Nada derivado se guarda (§3.5).

model Cuenta {
  id        String        @id @db.Uuid
  banco     String
  tipo      String
  ultimos4  String?
  creada_en DateTime      @default(now()) @db.Timestamptz(6)
  saldos    SaldoCuenta[]
}

model SaldoCuenta {
  id         String   @id @db.Uuid
  cuenta_id  String   @db.Uuid
  cuenta     Cuenta   @relation(fields: [cuenta_id], references: [id], onDelete: Restrict)
  valor      BigInt
  anotado_en DateTime @default(now()) @db.Timestamptz(6)

  @@index([cuenta_id, anotado_en])
}

model Deuda {
  id            String       @id @db.Uuid
  tipo          String
  nombre        String
  con_quien     String
  tasa_ea       Decimal?     @db.Decimal(5, 2)
  cuota         BigInt?
  creada_en     DateTime     @default(now()) @db.Timestamptz(6)
  cupo          BigInt?
  monto_inicial BigInt?
  ultimos4      String?
  cuotas_total  Int?
  dia_pago      Int?
  primera_cuota DateTime?    @db.Date
  saldos        SaldoDeuda[]
  extractos     Extracto[]
}

model SaldoDeuda {
  id         String   @id @db.Uuid
  deuda_id   String   @db.Uuid
  deuda      Deuda    @relation(fields: [deuda_id], references: [id], onDelete: Restrict)
  valor      BigInt
  anotado_en DateTime @default(now()) @db.Timestamptz(6)

  @@index([deuda_id, anotado_en])
}

model Extracto {
  id           String    @id @db.Uuid
  deuda_id     String    @db.Uuid
  deuda        Deuda     @relation(fields: [deuda_id], references: [id], onDelete: Restrict)
  cierre       DateTime  @db.Date
  intereses    BigInt
  pago_minimo  BigInt?
  fecha_limite DateTime? @db.Date
  anotado_en   DateTime  @default(now()) @db.Timestamptz(6)

  @@index([deuda_id, cierre])
}

model Tema {
  id        String           @id @db.Uuid
  nombre    String           @unique
  creado_en DateTime         @default(now()) @db.Timestamptz(6)
  registros RegistroTiempo[]
}

model RegistroTiempo {
  id         String   @id @db.Uuid
  tema_id    String   @db.Uuid
  tema       Tema     @relation(fields: [tema_id], references: [id], onDelete: Restrict)
  minutos    Int
  fecha      DateTime @db.Date
  anotado_en DateTime @default(now()) @db.Timestamptz(6)

  @@index([fecha])
}
